# LogLens configuration. Copy to .env and edit: cp .env.example .env
# Never commit .env. Values below are safe placeholders, not secrets.

# --- API server -------------------------------------------------------------
# Address the API listens on. Docker Compose pins this to 0.0.0.0:8080 inside the container.
LOGLENS_BIND=0.0.0.0:8080
# SQLite database (users, AI severity cache, alert state). Compose pins it to the /data volume.
LOGLENS_DB_URL=sqlite:///data/loglens.db
# Loki base URL as seen from the API container (no trailing slash).
LOGLENS_LOKI_URL=http://loki:3100

# --- Secrets ----------------------------------------------------------------
# `bash init-env.sh` creates .env from this file and fills the three secrets below.
# Placeholder or weak values are rejected at startup.
# Admin account created on first start only (when no user exists yet). At least 10 characters.
LOGLENS_ADMIN_USER=admin
LOGLENS_ADMIN_PASSWORD=
# JWT signing secret, at least 32 random characters (openssl rand -hex 32).
LOGLENS_JWT_SECRET=
# Token remote Vector agents send when pushing logs (install-agent.sh <url> <token>).
LOGLENS_PUSH_TOKEN=
# Browser origins allowed to call the API directly (the native mobile app).
LOGLENS_CORS_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost

# --- AI provider ------------------------------------------------------------
# ollama | openai (any OpenAI-compatible API: OpenAI, vLLM, LM Studio, OpenRouter, ...)
LOGLENS_AI_PROVIDER=ollama
# Ollama on the Docker host. With the compose "ollama" profile use http://ollama:11434.
# For OpenAI use https://api.openai.com (a trailing /v1 is also accepted).
LOGLENS_AI_URL=http://host.docker.internal:11434
LOGLENS_AI_MODEL=llama3.1:8b
# API key for OpenAI-compatible providers. Leave empty for Ollama.
LOGLENS_AI_KEY=
# Replace IPs and usernames with placeholders before logs are sent to the AI provider.
LOGLENS_AI_MASK=true

# --- Alerts (ntfy) ----------------------------------------------------------
# Leave LOGLENS_NTFY_URL empty to disable alerts.
LOGLENS_NTFY_URL=http://ntfy:80
# Topic name doubles as a password: init-env.sh generates a random one.
LOGLENS_NTFY_TOPIC=loglens-alerts

# --- Docker Compose ports and ntfy server (read by docker-compose.yml only) --
# Version of the LogLens images pulled from ghcr.io (docker compose pull).
LOGLENS_VERSION=0.1.0
# Web UI port on the host, and the address it binds to (127.0.0.1 = only via Tailscale/localhost).
LOGLENS_WEB_PORT=8080
LOGLENS_WEB_BIND=0.0.0.0
LOGLENS_NTFY_BIND=0.0.0.0

# --- Tailscale (optional: docker compose --profile tailscale up -d) ----------
# Auth key from https://login.tailscale.com/admin/settings/keys (reusable or one-off; needed on first start only).
TS_AUTHKEY=
# Machine name in your tailnet: the app is served at https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=loglens
# Extra `tailscale up` flags, e.g. --advertise-tags=tag:loglens
TS_EXTRA_ARGS=
# Loki port, bound to 127.0.0.1 on the host for debugging. Agents push through the web port.
LOGLENS_LOKI_PORT=3100
# ntfy port on the host; subscribe from the ntfy phone app at http://<server>:8090.
LOGLENS_NTFY_PORT=8090
# Public URL of the ntfy server (optional, e.g. http://192.168.1.10:8090).
LOGLENS_NTFY_BASE_URL=
# Set to https://ntfy.sh for instant iOS notifications (requires LOGLENS_NTFY_BASE_URL).
LOGLENS_NTFY_UPSTREAM_BASE_URL=
